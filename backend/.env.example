# Copia este archivo a .env y coloca tus valores reales.

# --- Google Gemini (motor GRATUITO de la recepcionista) ---
# Consíguela gratis en https://aistudio.google.com/  (Get API key)
GEMINI_API_KEY=

# --- Claude / Anthropic (asistente de investigación jurídica, de pago) ---
# Obtén una clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Servidor ---
PORT=8000

# ====================================================================== #
# Integración con Meta (WhatsApp Business, Messenger, Instagram)
# ====================================================================== #

# Token que TÚ inventas; debe coincidir con el que pongas en el panel de Meta
# al configurar el webhook (campo "Verify token").
META_VERIFY_TOKEN=xix-verify-token

# Secreto de tu app de Meta (App Settings > Basic > App Secret).
# Recomendado para validar la firma de los eventos entrantes.
META_APP_SECRET=

# --- WhatsApp Cloud API ---
# Token de acceso de WhatsApp y el ID del número de teléfono
# (WhatsApp > API Setup en el panel de Meta for Developers).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Messenger (Facebook) e Instagram ---
# Token de acceso de la Página de Facebook conectada (sirve para ambos).
PAGE_ACCESS_TOKEN=
